# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual token.

# Get this from the Cloudflare Zero Trust dashboard:
# Zero Trust → Networks → Tunnels → Create a tunnel → Docker → copy the token
CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# Set to 0 on a public deployment so visitors can't trigger model downloads.
# ALLOW_MODEL_DOWNLOAD=1
